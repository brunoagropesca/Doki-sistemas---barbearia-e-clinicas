# Ambiente dos testes automatizados.
#
# Repare no DATABASE_URL: os testes usam um arquivo SEPARADO. Isso nao e
# detalhe — teste que roda no banco de desenvolvimento apaga o trabalho de
# quem esta testando a tela ao lado, e um dia apaga dado de producao.

NODE_ENV=test
DATABASE_URL=file:./data/teste.db
APP_SECRET=segredo-exclusivo-de-teste-com-mais-de-32-caracteres
PORT=0
LOG_LEVEL=silent
LOG_PRETTY=false
CORS_ORIGINS=http://localhost:5173

# Os testes nao podem falar com o Google.
IA_TESTE_AUTOMATICO=false

# Fotos enviadas pelos testes vao para uma pasta propria: sem isto elas se
# misturavam as fotos reais da empresa em data/uploads.
PASTA_ARQUIVOS=data/uploads-teste
BACKUP_DIR=data/backups-teste
LICENCA_EXIGIDA=false
LICENCA_ARQUIVO=data/licenca-teste.json
