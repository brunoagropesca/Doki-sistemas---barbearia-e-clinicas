{
  "name": "@plataforma/api",
  "version": "0.1.0",
  "private": true,
  "description": "API da Plataforma de Atendimento — CRM, agenda e atendimento com IA para clinicas e barbearias.",
  "type": "module",
  "main": "src/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.js",
    "start": "node --env-file-if-exists=.env src/main.js",
    "env:preparar": "node src/db/preparar-env.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:instalar": "node --env-file-if-exists=.env src/db/instalar-cli.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.js",
    "db:check": "node --env-file-if-exists=.env src/db/check.js",
    "usuario:dev": "node --env-file-if-exists=.env src/db/usuario-dev.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "licenca:gerar": "node --env-file-if-exists=.env src/licenca/gerar-serial.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@libsql/client": "^0.18.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
