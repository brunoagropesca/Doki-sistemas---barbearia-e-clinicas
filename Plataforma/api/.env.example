# Copie este arquivo para `.env` e ajuste o que precisar.
# O `.env` NAO vai pro Git (veja .gitignore) — ele guarda segredos.

NODE_ENV=development

# --- Servidor ---
PORT=3333
# 127.0.0.1 aceita conexao so desta maquina — e deve continuar assim.
# Para abrir o painel pelo celular/outro computador do mesmo Wi-Fi, use o
# INICIAR-NA-REDE.bat: ele abre so as telas (porta 5173) para a rede, e elas
# repassam as chamadas para a API aqui dentro. Nao precisa mexer nesta linha.
HOST=127.0.0.1

# Quais enderecos podem chamar a API pelo navegador, separados por virgula.
# 5173 e a porta padrao do Vite (o front em desenvolvimento).
CORS_ORIGINS=http://localhost:5173

# --- Banco ---
# `file:` = SQLite local. Para ir pra nuvem depois, troque por libsql://...
DATABASE_URL=file:./data/plataforma.db

# --- Seguranca ---
# OBRIGATORIO trocar em producao. Minimo 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=dev-secret-trocar-em-producao-1234567890

SESSION_TTL_DAYS=7

# --- Logs ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- Painel de atividade (terminal colorido, so em desenvolvimento) ---
# Narra cada acao: mensagem recebida, qual modelo respondeu na cascata,
# Sofia falando com a Atena. PAINEL_CONTEUDO=false esconde o texto das
# mensagens dos clientes (util com a janela compartilhada numa reuniao).
PAINEL_ATIVO=true
PAINEL_CONTEUDO=true
PAINEL_LEITURAS=false

# --- Integracoes ---
WHATSAPP_AUTH_DIR=./data/whatsapp
UPLOADS_DIR=./data/uploads

# --- Teste automatico dos modelos de IA ---
# Testa os modelos do Gemini ao iniciar e ao salvar uma chave nova.
IA_TESTE_AUTOMATICO=true
# So retesta ao iniciar se o ultimo teste for mais velho que isto (em horas).
IA_TESTE_VALIDADE_HORAS=6
