+ * as 18h continuava "online" ate alguem mudar na mao — e a distribuicao
+ * entregava a ela o cliente que pediu uma pessoa as 8h da manha seguinte.
+ *
+ * O painel mantem uma conexao de tempo real aberta (/api/eventos). Sem nenhuma
+ * conexao da pessoa por AUSENTE_APOS_MS, quem estava "online" vira "ausente"
+ * (a distribuicao, por padrao, so entrega para "online"). Quando ela volta a
+ * abrir o painel, volta a "online" — so se foi o SISTEMA que a tirou: quem
+ * escolheu "ausente" na mao continua ausente.
+ */
+export const AUSENTE_APOS_MS = 5 * 60_000;
+
+const abertas = new Map(); // userId -> quantas conexoes
+const timers = new Map(); // userId -> timer
+const tiradosPeloSistema = new Set();
+
+export function painelAberto(tenantId, userId) {
+  abertas.set(userId, (abertas.get(userId) ?? 0) + 1);
+  clearTimeout(timers.get(userId));
+  timers.delete(userId);
+  if (tiradosPeloSistema.delete(userId)) {
+    mudar(tenantId, userId, 'ausente', 'online').catch((err) => log.warn({ err, userId }, 'Nao foi possivel voltar a online'));
+  }
+}
+
+export function painelFechado(tenantId, userId, { aposMs = AUSENTE_APOS_MS } = {}) {
+  const restantes = Math.max(0, (abertas.get(userId) ?? 1) - 1);
+  if (restantes > 0) return abertas.set(userId, restantes);
+  abertas.delete(userId);
+  clearTimeout(timers.get(userId));
+  const t = setTimeout(async () => {
+    timers.delete(userId);
+    if (abertas.get(userId)) return;
+    try {
+      if (await mudar(tenantId, userId, 'online', 'ausente')) tiradosPeloSistema.add(userId);
+    } catch (err) {
+      log.warn({ err, userId }, 'Nao foi possivel marcar ausente');
+    }
+  }, aposMs);
+  t.unref?.();
+  timers.set(userId, t);
+}
+
+/** Ao ligar o servidor: quem esta "online" mas sem painel aberto (servidor caiu, reiniciou). */
+export async function marcarAusentesSemPainel() {
+  const online = await db.select({ id: users.id, tenantId: users.tenantId }).from(users).where(eq(users.statusPresenca, 'online'));
+  for (const u of online) {
+    if (!abertas.get(u.id) && (await mudar(u.tenantId, u.id, 'online', 'ausente'))) tiradosPeloSistema.add(u.id);
+  }
+}
+
+/** Troca de->para so se o status atual ainda for `de` (nao briga com quem mudou na mao). */
+async function mudar(tenantId, userId, de, para) {
+  const r = await db.update(users).set({ statusPresenca: para }).where(and(eq(users.id, userId), inArray(users.statusPresenca, [de])));
+  const mudou = (r.rowsAffected ?? 0) > 0;
+  if (mudou) {
+    log.info({ userId, de, para }, 'Presenca ajustada pelo painel');
+    emitir(EVENTOS.CONVERSA, { tenantId });
+  }
+  return mudou;
+}
+
+/** So para os testes. */
+export function _zerarPresenca() {
+  for (const t of timers.values()) clearTimeout(t);
+  abertas.clear(); timers.clear(); tiradosPeloSistema.clear();
+}
